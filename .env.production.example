# 生产环境变量模板。复制为部署平台密钥/变量，不要提交填好密钥的文件。
NODE_ENV=production
ENABLE_DEMO_SEED=false

# 单机 Compose 可使用内置 PostgreSQL。密码仅用 URL 安全字符，或对特殊字符做 URL 编码。
POSTGRES_USER=aikefu
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=aikefu
API_DATABASE_URL=postgresql://aikefu:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@postgres:5432/aikefu?schema=public

# 单机 Compose Redis。托管 Redis 请改成平台提供的 rediss:// URL。
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_RANDOM_REDIS_PASSWORD@redis:6379

# 由 HTTPS 反向代理提供公网入口；容器端口默认只绑定回环地址。
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_WECOM_CALLBACK_BASE=https://api.example.com
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
AI_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# 必须分别生成不同的随机密钥，建议每项至少 32 个随机字节。
AUTH_SECRET=
AI_KEY_SECRET=
AI_SERVICE_TOKEN=

# 首次空库启动时引导管理员；创建成功后从部署环境移除密码。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_NAME=

# AI 模型也可在租户设置中配置。生产 embedding 必须使用真实 embedding 服务。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=
