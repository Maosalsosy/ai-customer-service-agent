# AI客服 Docker / 本地环境变量示例（勿填真实密钥）

POSTGRES_USER=aikefu
POSTGRES_PASSWORD=aikefu
POSTGRES_DB=aikefu
POSTGRES_PORT=5433
REDIS_PORT=6379
AI_PORT=8000

# 本机开发默认仅监听回环地址；生产环境应由受控反向代理访问容器网络
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
AI_BIND=127.0.0.1
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# Docker Compose 将 Postgres 映射到本机 5433；纯本地 Postgres 仍可用 5432
DATABASE_URL=postgresql://aikefu:aikefu@localhost:5433/aikefu?schema=public
# Compose 容器内 API 使用此地址；留空时自动指向 Compose PostgreSQL 服务
API_DATABASE_URL=

API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# 企业微信回调公网基址（须 HTTPS，勿用 localhost）；留空则页面用 NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_WECOM_CALLBACK_BASE=

# 开发、演示和生产统一使用 PostgreSQL/Prisma/pgvector。
# 本地演示数据；生产环境必须设为 false
ENABLE_DEMO_SEED=true

# Compose 中 API 与 AI 服务必须使用同一个值
AI_SERVICE_TOKEN=dev-ai-token

# API 生产必需；Compose 演示留空时使用容器内 Redis 默认地址
REDIS_URL=
REDIS_PASSWORD=

# API JWT 签名密钥（生产务必更换）
AUTH_SECRET=dev-auth-secret-change-me
# 模型 API Key 落库加密；留空则回退 AUTH_SECRET
AI_KEY_SECRET=

# 仅在 production 且使用空数据库首次启动时需要；密码至少 12 位
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_NAME=

# DeepSeek（密钥只放这里或容器环境，不要提交真实值）
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 知识库向量（优先于聊天 Profile）。DeepSeek 公开站无 embeddings，聊天用 DeepSeek 时请另配兼容接口。
# 例：https://api.siliconflow.cn/v1 或 https://api.openai.com/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 留空则按 baseUrl 默认（SiliconFlow→BAAI/bge-m3，其它→text-embedding-3-small）
EMBEDDING_MODEL=
